GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
FREEAGENT_VAULT_KEY=
FREEAGENT_PRIVACY_MODE=strict
FREEAGENT_GMAIL_SEND=0
FREEAGENT_PROFILE_DIR=
