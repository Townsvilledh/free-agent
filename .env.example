# Names only — NEVER put real values in this file or commit a filled .env
# NONE of these are required: the default keyless brain needs no key at
# all (see KEYLESS.md). These only enable OPTIONAL personal-key providers.
AGENTROUTER_API_KEY=
[SECURITY_DATA]
GEMINI_API_KEY=
[SECURITY_DATA]
CEREBRAS_API_KEY=
# A custom OpenAI-compatible endpoint (your own server): base URL +
# key together enable the route; the model name is optional.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
[SECURITY_DATA]
CLOUDFLARE_API_TOKEN=
[SECURITY_DATA]
FREEAGENT_PRIVACY_MODE=strict
FREEAGENT_GMAIL_SEND=0
FREEAGENT_PROFILE_DIR=
