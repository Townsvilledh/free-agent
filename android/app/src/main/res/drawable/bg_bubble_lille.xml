<!-- Lille's message bubble (v0.10 UI polish): warm dark surface,
     rounded, subtle top-light gradient for the glossy finish. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#2E2A26"
        android:endColor="#211E1B"
        android:angle="270" />
    <corners
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp"
        android:bottomRightRadius="18dp"
        android:bottomLeftRadius="4dp" />
</shape>
