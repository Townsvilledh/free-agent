<!-- Rounded card surface (v0.10 UI polish) — the login screen's
     card, same visual language as the chat bubbles. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#26231F"
        android:endColor="#1B1A18"
        android:angle="270" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#37332D" />
</shape>
