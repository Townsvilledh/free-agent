    <!-- v0.11: backup & restore -->
    <string name="backup_open">Backup &amp; restore</string>
    <string name="backup_settings_hint">Automatic, encrypted backup of your chats, tasks and Lille\'s vault — locked by your Fluid wallet, restorable on a new phone.</string>
    <string name="backup_title">Backup &amp; restore</string>
    <string name="backup_explain">Your backup is a locked file only your Fluid wallet can open. Lille seals your chats, tasks and her vault into it automatically — to a folder on this phone, and (if you consent) to your own Google Drive. Google stores the lock-box, never the key. No Fluid wallet, no restore — ever: the key is your wallet\'s signature, and nobody else can produce it.</string>
    <string name="backup_setup">Set up automatic backup</string>
    <string name="backup_choose_folder">Choose backup folder</string>
    <string name="backup_drive">Google Drive sync</string>
    <string name="backup_sessions_optin">Include my browser logins in the backup</string>
    <string name="backup_sessions_warning">A browser login (like your X session) inside a backup is a logged-in account in a file — sealed with the same encryption, but only turn this on if you want those sessions to survive a phone switch.</string>
    <string name="backup_now">Back up now</string>
