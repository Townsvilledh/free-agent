<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- v0.10 UI polish: the login arrives on the same rounded
         card language as the chat screen — dark warm surface,
         glossy orange primary button. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/mascot_idle"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="#F5EFE7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/fluid_tagline"
            android:textColor="#F7931A"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/fluid_explain"
            android:textColor="#CFC8BC"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fluidNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_composer"
            android:hint="@string/fluid_name_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="#F5EFE7"
            android:textColorHint="#8A8378" />

        <Button
            android:id="@+id/fluidConnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_accent"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/fluid_connect"
            android:textColor="#1A1206"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fluidStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#F5EFE7"
            android:textSize="14sp" />

        <!-- Pairing view: shown once a wc: code exists. The code
             is selectable text + a Copy button; the steps mirror
             Fluid's own More → WalletConnect paste flow. -->
        <LinearLayout
            android:id="@+id/pairingBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fluid_pairing_steps"
                android:textColor="#F5EFE7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pairingCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pairing_code"
                android:padding="10dp"
                android:textColor="#F5EFE7"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/copyPairingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fluid_copy_code" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/fluid_waiting"
                android:textColor="#CFC8BC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/cancelPairingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/fluid_cancel" />
        </LinearLayout>

        <Button
            android:id="@+id/getFluidButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_composer"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/fluid_get"
            android:textColor="#F5EFE7" />
    </LinearLayout>
</ScrollView>
