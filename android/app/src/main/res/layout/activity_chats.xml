<?xml version="1.0" encoding="utf-8"?>
<!-- Chat list (v0.11): every saved conversation, newest
     activity first. Rows are built by ChatListActivity —
     title, when it last moved, how many messages, and a
     delete button (with a confirm). Tap a row to open it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chats_title"
            android:textColor="#F5EFE7"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/newChatButton2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_chat" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
