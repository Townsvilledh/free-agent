<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: identity, wallet, backup, your API keys
     (v0.12.1), disconnect. The key provider blocks are
     built programmatically into settingsKeysContainer by
     SettingsActivity — one block per OwnKeyRoutes spec. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/settings_title"
            android:textColor="#F5EFE7"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsIdentity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textColor="#B9B0A2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/settingsWalletButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wallet_open" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:text="@string/wallet_settings_hint"
            android:textColor="#8A8378"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settingsBackupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_open" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:text="@string/backup_settings_hint"
            android:textColor="#8A8378"
            android:textSize="13sp" />

        <!-- Referrals (REFERRALS.md): the user's invite link,
             share + copy, the completed-invite count, and the
             export/import sync between their own phones. The
             views are filled by SettingsActivity. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/settings_referral_title"
            android:textColor="#F5EFE7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/settings_referral_hint"
            android:textColor="#8A8378"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settingsReferralLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pairing_code"
            android:padding="10dp"
            android:textColor="#F5EFE7"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settingsReferralCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="#B9B0A2"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/settingsReferralShareButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/referral_share" />

            <Button
                android:id="@+id/settingsReferralCopyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/referral_copy" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsReferralExportButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/referral_export" />

            <Button
                android:id="@+id/settingsReferralImportButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/referral_import" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:text="@string/settings_referral_sync_hint"
            android:textColor="#8A8378"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/settings_kit_title"
            android:textColor="#F5EFE7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_kit_hint"
            android:textColor="#8A8378"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/settingsKitContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/settings_keys_title"
            android:textColor="#F5EFE7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_keys_hint"
            android:textColor="#8A8378"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/settingsKeysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/settingsDisconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disconnect_fluid" />

        <TextView
            android:id="@+id/settingsVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:textColor="#8A8378"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
