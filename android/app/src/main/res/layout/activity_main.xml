<?xml version="1.0" encoding="utf-8"?>
<!-- Chat screen (v0.10 UI polish): near-black ground in Fluid's
     identity, message bubbles (dark warm surface for Lille,
     glossy Bitcoin-orange for the user), and a pill composer
     with ICON buttons — paperclip attach, paper-plane send —
     instead of text buttons. Same ids, same behaviour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Lille mascot + name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/headerMascot"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/mascot_idle"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="#F5EFE7"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/newChatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_chat" />
    </LinearLayout>

    <!-- Update banner (v0.12.1): hidden unless
         UpdateChecker finds a newer version on the
         distribution branch that wasn't dismissed. The
         text opens the one-tap APK link; Later dismisses
         this version only. -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bubble_lille"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5EFE7"
            android:textSize="14sp" />

        <Button
            android:id="@+id/updateBannerDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_later" />
    </LinearLayout>

    <!-- Nav row (v0.11): Chats (multiple conversations) ·
         Tasks · Settings (backup lives there). Same screens,
         one tap each. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <Button
            android:id="@+id/chatsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chats" />
        <Button
            android:id="@+id/tasksButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/tasks" />
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- Bubbles are added here by MainActivity.appendLine —
             one rounded bubble view per message. -->
        <LinearLayout
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </ScrollView>

    <!-- Attachment preview: shown above the input when a file/image
         has been picked. Thumbnail (images) + display name + remove. -->
    <LinearLayout
        android:id="@+id/attachmentBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/attachmentThumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/attachment"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/attachmentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#F5EFE7"
            android:textSize="13sp" />
        <Button
            android:id="@+id/clearAttachmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove" />
    </LinearLayout>

    <!-- Composer: pill field with integrated icon buttons.
         Touch targets are 48dp; contentDescriptions carry the
         words the buttons used to wear. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/attachButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Attach a file"
            android:padding="12dp"
            android:src="@drawable/ic_attach"
            android:tint="#E8E2D9" />
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_composer"
            android:hint="@string/message_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="#F5EFE7"
            android:textColorHint="#8A8378" />
        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button_accent"
            android:contentDescription="Send message"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:tint="#1A1206" />
    </LinearLayout>
</LinearLayout>
