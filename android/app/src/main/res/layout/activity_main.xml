<?xml version="1.0" encoding="utf-8"?>
<!-- Chat screen (v0.10 UI polish): near-black ground in Fluid's
     identity, message bubbles (dark warm surface for Lille,
     glossy Bitcoin-orange for the user), and a pill composer
     with ICON buttons — paperclip attach, paper-plane send —
     instead of text buttons. Same ids, same behaviour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header (v1.0.1 slim chrome): mascot + name, then
         SMALL icon controls — chats list, new chat,
         settings, and the packaged-actions menu — as
         symbols, not text buttons. Tonal and quiet;
         orange stays the alive accent only (the
         composer's send button). Nothing shouts over
         the conversation. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <ImageView
            android:id="@+id/headerMascot"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/mascot_idle"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="#F5EFE7"
            android:textSize="17sp" />
        <ImageButton
            android:id="@+id/chatsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/chats"
            android:padding="9dp"
            android:src="@drawable/ic_chats" />
        <ImageButton
            android:id="@+id/newChatButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/new_chat"
            android:padding="9dp"
            android:src="@drawable/ic_new_chat" />
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/settings"
            android:padding="9dp"
            android:src="@drawable/ic_settings" />
        <Button
            android:id="@+id/menuButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_button"
            android:text="⋯"
            android:textColor="#E8E2D9"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Wallet card (v1.0.1): her companion wallet lives
         on the main page — balances at a glance across
         her families, honest load states (a failed read
         says "couldn't load", never a fake zero). Tap
         opens the full Wallet screen. -->
    <LinearLayout
        android:id="@+id/walletCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bubble_lille"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lille's wallet"
            android:textColor="#B8B0A4"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/walletCardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F5EFE7"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Update banner (v0.12.1): hidden unless
         UpdateChecker finds a newer version on the
         distribution branch that wasn't dismissed. The
         text opens the one-tap APK link; Later dismisses
         this version only. -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bubble_lille"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5EFE7"
            android:textSize="14sp" />

        <Button
            android:id="@+id/updateBannerDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_later" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- Bubbles are added here by MainActivity.appendLine —
             one rounded bubble view per message. -->
        <LinearLayout
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </ScrollView>

    <!-- The in-chat live browser panel (v1.0.1): her real
         WebView session in the conversation while this
         chat's work is in a browser step — watch her drive,
         take over, pass a human check right here, hand
         back. Hidden whenever the work is not browsing.
         Expand trades the transcript's space for the
         panel's; the session is untouched. -->
    <LinearLayout
        android:id="@+id/browserPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bubble_lille"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/browserPanelLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F5EFE7"
                android:textSize="13sp" />
            <!-- Panel controls (v1.0.3): small tonal icon
                 buttons in the shared menu language — no
                 text bars. Expand trades the transcript's
                 space for the panel's; the action button is
                 take-over (wheel) or hand-back (return
                 arrow) by state; close dismisses the panel
                 while the work keeps running. -->
            <ImageButton
                android:id="@+id/browserPanelExpand"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Expand"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_expand" />
            <ImageButton
                android:id="@+id/browserPanelAction"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Take over"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_takeover" />
            <ImageButton
                android:id="@+id/browserPanelClose"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Close — she keeps working"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />
        </LinearLayout>
        <TextView
            android:id="@+id/browserPanelWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="#B9B0A2"
            android:textSize="13sp"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/browserPanelContainer"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- The dismissed-panel indicator (v1.0.3): while the
         panel is closed the browser work keeps running
         behind the chat; this slim chip is its presence —
         one tap brings the panel back. A park reopens the
         panel on its own and the chip steps aside. -->
    <TextView
        android:id="@+id/browserChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:textColor="#E8E2D9"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- Attachment preview: shown above the input when a file/image
         has been picked. Thumbnail (images) + display name + remove. -->
    <LinearLayout
        android:id="@+id/attachmentBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/attachmentThumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/attachment"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/attachmentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#F5EFE7"
            android:textSize="13sp" />
        <Button
            android:id="@+id/clearAttachmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove" />
    </LinearLayout>

    <!-- Reply quote bar (v1.0.1): while composing a reply,
         the quoted message shows here with a cancel control. -->
    <LinearLayout
        android:id="@+id/quoteBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/quoteBarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5EFE7"
            android:textSize="13sp" />
        <Button
            android:id="@+id/clearQuoteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove" />
    </LinearLayout>

    <!-- Composer: pill field with integrated icon buttons.
         Touch targets are 48dp; contentDescriptions carry the
         words the buttons used to wear. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/attachButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Attach a file"
            android:padding="12dp"
            android:src="@drawable/ic_attach"
            android:tint="#E8E2D9" />
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_composer"
            android:hint="@string/message_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="#F5EFE7"
            android:textColorHint="#8A8378" />
        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button_accent"
            android:contentDescription="Send message"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:tint="#1A1206" />
    </LinearLayout>
</LinearLayout>
