<?xml version="1.0" encoding="utf-8"?>
<!-- Chat screen (v0.10 UI polish): near-black ground in Fluid's
     identity, message bubbles (dark warm surface for Lille,
     glossy Bitcoin-orange for the user), and a pill composer
     with ICON buttons — paperclip attach, paper-plane send —
     instead of text buttons. Same ids, same behaviour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header (v1.0.1 organisation): mascot + name, then
         QUIET tonal controls — Chats, New, and one menu
         (packaged jobs, Wallet, Settings). True black,
         tonal surfaces, orange spent only as the alive
         accent (the composer's send button). The old stack
         of big orange buttons over the conversation is
         gone; nothing shouts over the chat. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/headerMascot"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/mascot_idle"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="#F5EFE7"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/chatsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon_button"
            android:text="@string/chats"
            android:textColor="#E8E2D9" />
        <Button
            android:id="@+id/newChatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:text="@string/new_chat"
            android:textColor="#E8E2D9" />
        <Button
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:text="⋯"
            android:textColor="#E8E2D9" />
    </LinearLayout>

    <!-- Update banner (v0.12.1): hidden unless
         UpdateChecker finds a newer version on the
         distribution branch that wasn't dismissed. The
         text opens the one-tap APK link; Later dismisses
         this version only. -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bubble_lille"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5EFE7"
            android:textSize="14sp" />

        <Button
            android:id="@+id/updateBannerDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_later" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- Bubbles are added here by MainActivity.appendLine —
             one rounded bubble view per message. -->
        <LinearLayout
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </ScrollView>

    <!-- The in-chat live browser panel (v1.0.1): her real
         WebView session in the conversation while this
         chat's work is in a browser step — watch her drive,
         take over, pass a human check right here, hand
         back. Hidden whenever the work is not browsing.
         Expand trades the transcript's space for the
         panel's; the session is untouched. -->
    <LinearLayout
        android:id="@+id/browserPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bubble_lille"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/browserPanelLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F5EFE7"
                android:textSize="13sp" />
            <Button
                android:id="@+id/browserPanelExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_icon_button"
                android:text="Expand"
                android:textColor="#E8E2D9" />
            <Button
                android:id="@+id/browserPanelAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_button"
                android:textColor="#E8E2D9" />
        </LinearLayout>
        <TextView
            android:id="@+id/browserPanelWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="#B9B0A2"
            android:textSize="13sp"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/browserPanelContainer"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Attachment preview: shown above the input when a file/image
         has been picked. Thumbnail (images) + display name + remove. -->
    <LinearLayout
        android:id="@+id/attachmentBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/attachmentThumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/attachment"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/attachmentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#F5EFE7"
            android:textSize="13sp" />
        <Button
            android:id="@+id/clearAttachmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove" />
    </LinearLayout>

    <!-- Reply quote bar (v1.0.1): while composing a reply,
         the quoted message shows here with a cancel control. -->
    <LinearLayout
        android:id="@+id/quoteBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/quoteBarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5EFE7"
            android:textSize="13sp" />
        <Button
            android:id="@+id/clearQuoteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove" />
    </LinearLayout>

    <!-- Composer: pill field with integrated icon buttons.
         Touch targets are 48dp; contentDescriptions carry the
         words the buttons used to wear. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/attachButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Attach a file"
            android:padding="12dp"
            android:src="@drawable/ic_attach"
            android:tint="#E8E2D9" />
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_composer"
            android:hint="@string/message_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="#F5EFE7"
            android:textColorHint="#8A8378" />
        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button_accent"
            android:contentDescription="Send message"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:tint="#1A1206" />
    </LinearLayout>
</LinearLayout>
