<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keyless free provider API (no key) + optional personal-key
         providers, and Gmail OAuth -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Approval notifications with Approve/Reject actions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opt-in foreground service for long tasks (user-started only) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v0.4: re-queue unfinished durable tasks after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeAgent"
        android:usesCleartextTraffic="false">
        <!-- allowBackup=false: the encrypted vault must never ride
             Android Auto Backup off the device. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v0.11: multiple chats — the conversation list.
             Opening a chat sets it active and returns to
             MainActivity (CLEAR_TOP + singleTop → onNewIntent
             re-renders). -->
        <activity
            android:name=".ChatListActivity"
            android:exported="false" />

        <!-- v0.11: settings (identity, backup, disconnect) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- v0.11: autonomous backup — setup, unlock, restore
             (BACKUP.md) -->
        <activity
            android:name=".BackupActivity"
            android:exported="false" />

        <!-- v0.10: Fluid login gate (LOGIN.md) — MainActivity
             redirects here whenever the gate says LOGIN -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- v0.4: durable background tasks screen -->
        <activity
            android:name=".TasksActivity"
            android:exported="false" />

        <!-- v0.9: PARKED_AT_WALL handoff — Lille's parked browser
             session full-screen, for the one human step -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false" />

        <!-- v0.4: WorkManager foreground workers (tasks run with a
             persistent notification while active) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- v0.4: reboot recovery for unfinished tasks -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- AppAuth OAuth redirect (Gmail, gmail.readonly) -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.freeagent.app" />
            </intent-filter>
        </activity>
    </application>
</manifest>
