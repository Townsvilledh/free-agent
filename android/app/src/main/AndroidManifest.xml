<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keyless free provider API (no key) + optional personal-key
         providers, and Gmail OAuth -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Device calendar (v1.0.4): her calendar tools read
         and (approval-gated) create events on the user's
         own calendar. Runtime-granted; without the grant
         the tools answer honestly and name the step. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Approval notifications with Approve/Reject actions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opt-in foreground service for long tasks (user-started only) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v0.4: re-queue unfinished durable tasks after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeAgent"
        android:usesCleartextTraffic="false">
        <!-- allowBackup=false: the encrypted vault must never ride
             Android Auto Backup off the device. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Referrals (REFERRALS.md): invite links. The
                 https filter is a verified App Link
                 (docs/.well-known/assetlinks.json is served
                 from the same Pages site); the lille://
                 scheme is the landing page's open-in-app
                 path for copies where verification is not in
                 place. Both land in MainActivity, which hands
                 the inviter to ReferralStore. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="townsvilledh.github.io"
                    android:pathPrefix="/free-agent/invite" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="lille"
                    android:host="invite" />
            </intent-filter>
        </activity>

        <!-- v0.11: multiple chats — the conversation list.
             Opening a chat sets it active and returns to
             MainActivity (CLEAR_TOP + singleTop → onNewIntent
             re-renders). -->
        <activity
            android:name=".ChatListActivity"
            android:exported="false" />

        <!-- v0.11: settings (identity, backup, disconnect) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- v0.12: Lille's agentic wallet (WALLET.md) -->
        <activity
            android:name=".WalletActivity"
            android:exported="false" />

        <!-- v0.12: the embedded Fluid sheet — Fluid's own web
             app inside Lille for login approvals ("sign where
             you stand"). A plain WebView container; Lille
             never reads its content. -->
        <activity
            android:name=".FluidSheetActivity"
            android:exported="false" />

        <!-- v0.11: autonomous backup — setup, unlock, restore
             (BACKUP.md) -->
        <activity
            android:name=".BackupActivity"
            android:exported="false" />

        <!-- v0.10: Fluid login gate (LOGIN.md) — MainActivity
             redirects here whenever the gate says LOGIN -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- The Tasks screen is REMOVED (v1.0.1, CHAT IS THE
             ENGINE): work lives in chats; the task store and
             engine remain as the chats' backbone. -->

        <!-- v0.9: PARKED_AT_WALL handoff — Lille's parked browser
             session full-screen, for the one human step -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false" />

        <!-- v0.4: WorkManager foreground workers (tasks run with a
             persistent notification while active) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- v0.4: reboot recovery for unfinished tasks -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- AppAuth OAuth redirect (Gmail, gmail.readonly) -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.freeagent.app" />
            </intent-filter>
        </activity>
    </application>
</manifest>
